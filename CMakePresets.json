{
  "version": 3,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release Preset",
      "description": "Standard Release Build",
      "binaryDir": "${sourceDir}/build/release",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_GUI": "ON",
        "BUILD_TESTS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug Preset",
      "description": "Debug Build with Sanitizers",
      "binaryDir": "${sourceDir}/build/debug",
      "generator": "Unix Makefiles",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_GUI": "ON",
        "BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
